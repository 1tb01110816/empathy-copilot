{
  "name": "empathy-copilot",
  "private": true,
  "version": "0.1.0",
  "description": "共情副驾（Empathy Copilot）— 电商客服工作台 AI 共情引擎 Demo",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm --workspace server run dev\" \"npm --workspace web run dev\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "start": "npm --workspace server run start",
    "test": "npm --workspace server run test",
    "typecheck": "npm --workspace web run typecheck",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
