# 阿里云百炼 DashScope API Key（https://bailian.console.aliyun.com/ → API-KEY 管理）
# 填入后自动启用通义千问（qwen-plus 文本 / qwen-vl-max 多模态）；留空则走本地规则引擎兜底
DASHSCOPE_API_KEY=

# 模型可覆盖（默认即可）
QWEN_TEXT_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-max

PORT=8787

# —— 公网访问口令（可选）：设置后全站启用 Basic Auth，/api/health 免鉴权 ——
# 留空则本地开放；Railway 等公网部署建议设置强随机口令（用户名默认 demo）
APP_ACCESS_CODE=
APP_AUTH_USER=demo

# —— MySQL（可选）：填入 DB_PASSWORD 后重启 server 自动建库并接入（首次启动自动导入 8 张 MOCK 表）——
# 留空或连接失败时自动降级为 JSON + 内存模式，演示不受影响
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=empathy_copilot
