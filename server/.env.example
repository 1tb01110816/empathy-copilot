# 阿里云百炼 DashScope API Key（https://bailian.console.aliyun.com/ → API-KEY 管理）
# 填入后自动启用通义千问（qwen-plus 文本 / qwen-vl-max 多模态）；留空则走本地规则引擎兜底
DASHSCOPE_API_KEY=

# 模型可覆盖（默认即可）
QWEN_TEXT_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-max

PORT=8787

# —— 公网访问口令（可选）：设置后启用登录页 + 邀请链接 + 7 天 Cookie；/api/health 免鉴权 ——
# 访问 https://<域名>/ 输入口令，或直接打开 /enter?code=<口令> 免输入进入；Basic Auth 仍兼容
# 留空则本地开放；Railway 等公网部署建议设置强随机口令
APP_ACCESS_CODE=
# 会话签名密钥（可选）：留空则由 APP_ACCESS_CODE 派生；更换口令会让所有旧 Cookie 失效
APP_SESSION_SECRET=
# Basic Auth 兼容用户名（登录页只校验口令，不使用此用户名）
APP_AUTH_USER=demo
# 登录尝试限流（次/分钟/IP，默认 10）
LOGIN_RATE_MAX=10

# —— MySQL（可选）：填入 DB_PASSWORD 后重启 server 自动建库并接入（首次启动自动导入 8 张 MOCK 表）——
# 留空或连接失败时自动降级为 JSON + 内存模式，演示不受影响
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=empathy_copilot
